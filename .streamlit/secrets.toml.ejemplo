# Copia este fichero a `secrets.toml` y pon tu clave.
#
# `secrets.toml` NO se sube a GitHub: está bloqueado en `.gitignore`.
# El repositorio es público, así que una clave subida ahí queda expuesta
# a todo el mundo y hay que revocarla de inmediato.
#
# En Streamlit Community Cloud la clave NO se pone en un fichero: se pega en
# el panel de la aplicación, en `Settings` → `Secrets`, con este mismo
# formato. Se guarda cifrada y no pasa por el repositorio.
#
# Clave gratuita: https://aistudio.google.com/apikey
#
# Si no hay clave, la aplicación funciona igual: el tutor devuelve preguntas
# del banco escrito a mano. No se rompe nada.

[gemini]
api_key = "pega-aqui-tu-clave"
